"""
Generated by doe on {{ timestamp }}
Operation: {{ operation }}
Total runs: {{ total_runs }}{% if plan_name %}
Plan: {{ plan_name }}{% endif %}
Parallelism: {{ parallel_workers }} concurrent worker(s){% if session_prefix is not none %}
Session prefix: {{ session_prefix or "(timestamp only)" }}{% endif %}
"""

import concurrent.futures
import datetime
import os
import shutil
import subprocess
import sys

RUNS = [
{% for run in runs %}    {
        "run_id": {{ run.run_id }},
        "block_id": {{ run.block_id }},
        "factors": {{ run.factor_values | tojson }},
    },
{% endfor %}]

TEST_SCRIPT = "{{ test_script }}"
BASE_OUT = "{{ base_out_directory }}"
FIXED_FACTORS = {{ fixed_factors | tojson }}
ARG_STYLE = "{{ arg_style }}"
SESSION_PREFIX = {% if session_prefix is none %}None{% else %}{{ session_prefix | tojson }}{% endif %}
PARALLEL_WORKERS = {{ parallel_workers }}

os.makedirs(BASE_OUT, exist_ok=True)

if SESSION_PREFIX is not None:
    timestamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    session_name = f"{SESSION_PREFIX}-{timestamp}" if SESSION_PREFIX else timestamp
    OUT_DIRECTORY = os.path.join(BASE_OUT, session_name)
    os.makedirs(OUT_DIRECTORY, exist_ok=True)
    latest_link = os.path.join(BASE_OUT, "latest")
    try:
        if os.path.islink(latest_link) or not os.path.lexists(latest_link):
            if os.path.islink(latest_link):
                os.unlink(latest_link)
            os.symlink(session_name, latest_link)
    except OSError as e:
        print(f"Warning: could not update {latest_link}: {e}", file=sys.stderr)
    matrix_src = os.path.join(BASE_OUT, "design_matrix.json")
    if os.path.isfile(matrix_src):
        shutil.copy2(matrix_src, os.path.join(OUT_DIRECTORY, "design_matrix.json"))
    print(f"Session: {OUT_DIRECTORY}")
    print(f"Latest:  {latest_link} -> {session_name}")
else:
    OUT_DIRECTORY = BASE_OUT


def _run_one(run):
    run_id = run["run_id"]
    factors = run["factors"]
    out_path = f"{OUT_DIRECTORY}/run_{run_id}.json"
    if os.path.exists(out_path):
        return run_id, "skipped"

    if ARG_STYLE == "env":
        env = dict(os.environ)
        env.update({k.upper(): v for k, v in factors.items()})
        env.update({k.upper(): v for k, v in FIXED_FACTORS.items()})
        cmd = [TEST_SCRIPT, "--out", out_path]
        kwargs = {"env": env}
    elif ARG_STYLE == "positional":
        cmd = [TEST_SCRIPT]
        cmd += list(factors.values()) + list(FIXED_FACTORS.values())
        cmd += ["--out", out_path]
        kwargs = {}
    else:
        cmd = [TEST_SCRIPT]
        for name, value in factors.items():
            cmd += [f"--{name}", value]
        for name, value in FIXED_FACTORS.items():
            cmd += [f"--{name}", value]
        cmd += ["--out", out_path]
        kwargs = {}

    try:
        subprocess.run(cmd, check=True, **kwargs)
        return run_id, "ok"
    except subprocess.CalledProcessError as e:
        return run_id, f"failed (exit {e.returncode})"


print(f"Starting {{ total_runs }} run(s) with {PARALLEL_WORKERS} worker(s)...")

failed = []
with concurrent.futures.ThreadPoolExecutor(max_workers=PARALLEL_WORKERS) as pool:
    futures = {pool.submit(_run_one, r): r["run_id"] for r in RUNS}
    for fut in concurrent.futures.as_completed(futures):
        rid, status = fut.result()
        if status == "ok":
            print(f"  Run {rid:>3}: ok")
        elif status == "skipped":
            print(f"  Run {rid:>3}: already complete, skipped")
        else:
            print(f"  Run {rid:>3}: {status}", file=sys.stderr)
            failed.append(rid)

if failed:
    print(f"\nWARNING: {len(failed)} run(s) failed: {failed}", file=sys.stderr)
    print(f"Results (partial) in: {OUT_DIRECTORY}")
    sys.exit(1)
print(f"\nAll runs complete. Results in: {OUT_DIRECTORY}")
