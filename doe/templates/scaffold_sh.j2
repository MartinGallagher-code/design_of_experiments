#!/usr/bin/env bash
# Test script for {{ plan_name or "this experiment" }}.
#
# Generated by `doe scaffold-test`. Edit the TODO block below to plug in
# your real test. The runner will invoke this script once per experiment
# run with the factor values for that run, and read the JSON file written
# to --out to record the responses.
set -euo pipefail

{% if arg_style == "double-dash" -%}
{%- for name in factor_names + fixed_factor_names %}
{{ name | sh_var }}=""
{%- endfor %}
OUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
{%- for name in factor_names + fixed_factor_names %}
    --{{ name }}) {{ name | sh_var }}="$2"; shift 2 ;;
{%- endfor %}
    --out) OUT="$2"; shift 2 ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
done
if [[ -z "$OUT" ]]; then echo "missing --out" >&2; exit 1; fi
{% elif arg_style == "env" -%}
# Factor values arrive as uppercase environment variables. Parse --out:
OUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
done
if [[ -z "$OUT" ]]; then echo "missing --out" >&2; exit 1; fi
{%- for name in factor_names + fixed_factor_names %}
{{ name | sh_var }}="${{ '{' }}{{ name | upper }}{{ '}' }}"
{%- endfor %}
{% else -%}
# Positional args followed by --out PATH.
{%- for name in factor_names + fixed_factor_names %}
{{ name | sh_var }}="${{ loop.index }}"
{%- endfor %}
shift {{ (factor_names + fixed_factor_names) | length }}
OUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
done
if [[ -z "$OUT" ]]; then echo "missing --out" >&2; exit 1; fi
{% endif %}

# ------------------------------------------------------------------
# TODO: run your test using the factor values above and compute one
# numeric value per response.
# ------------------------------------------------------------------
{%- for name in response_names %}
{{ name | sh_var }}=0.0  # TODO: replace with measured {{ name }}
{%- endfor %}

mkdir -p "$(dirname "$OUT")"
cat > "$OUT" <<JSON
{
{%- for name in response_names %}
  "{{ name }}": ${{ '{' }}{{ name | sh_var }}{{ '}' }}{% if not loop.last %},{% endif %}
{%- endfor %}
}
JSON
