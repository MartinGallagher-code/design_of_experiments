#!/usr/bin/env bash
# Copyright (C) 2026 Martin J. Gallagher
# SPDX-License-Identifier: GPL-3.0-or-later
# Generated by doe on {{ timestamp }}
# Operation: {{ operation }}
# Total runs: {{ total_runs }}{% if plan_name %}
# Plan: {{ plan_name }}{% endif %}{% if session_prefix is not none %}
# Session prefix: {{ session_prefix or "(timestamp only)" }}{% endif %}
#
# Submit with:  sbatch {{ slurm_script_basename }}
# Inspect with: squeue -u $USER  /  sacct -j <jobid>

#SBATCH --job-name={{ slurm_job_name }}
#SBATCH --array=1-{{ total_runs }}{% if slurm_max_concurrent %}%{{ slurm_max_concurrent }}{% endif %}
#SBATCH --output={{ slurm_log_dir }}/run_%A_%a.out
#SBATCH --error={{ slurm_log_dir }}/run_%A_%a.err
{% if slurm_time %}#SBATCH --time={{ slurm_time }}
{% endif %}{% if slurm_partition %}#SBATCH --partition={{ slurm_partition }}
{% endif %}{% if slurm_cpus_per_task %}#SBATCH --cpus-per-task={{ slurm_cpus_per_task }}
{% endif %}{% if slurm_mem %}#SBATCH --mem={{ slurm_mem }}
{% endif %}{% for line in slurm_extra_directives %}#SBATCH {{ line }}
{% endfor %}
set -uo pipefail
mkdir -p "{{ base_out_directory }}"
mkdir -p "{{ slurm_log_dir }}"

{% if session_prefix is not none -%}
# All array tasks share the same session: the controlling shell stamps a
# timestamp once before submitting and exports SESSION_DIR via sbatch.
if [[ -z "${DOE_SESSION_DIR:-}" ]]; then
  TIMESTAMP=$(date +%Y%m%d-%H%M%S)
  {% if session_prefix -%}
  SESSION_NAME="{{ session_prefix }}-${TIMESTAMP}"
  {%- else -%}
  SESSION_NAME="${TIMESTAMP}"
  {%- endif %}
  OUT_DIRECTORY="{{ base_out_directory }}/${SESSION_NAME}"
  mkdir -p "$OUT_DIRECTORY"
  LATEST_LINK="{{ base_out_directory }}/latest"
  if [[ -L "$LATEST_LINK" || ! -e "$LATEST_LINK" ]]; then
    ln -sfn "$SESSION_NAME" "$LATEST_LINK"
  fi
  if [[ -f "{{ base_out_directory }}/design_matrix.json" ]]; then
    cp "{{ base_out_directory }}/design_matrix.json" "$OUT_DIRECTORY/design_matrix.json"
  fi
  echo "Session: $OUT_DIRECTORY"
  echo "Resubmit with DOE_SESSION_DIR=\"$OUT_DIRECTORY\" sbatch ... if you want to share it."
else
  OUT_DIRECTORY="$DOE_SESSION_DIR"
fi
{%- else -%}
OUT_DIRECTORY="{{ base_out_directory }}"
{%- endif %}

case ${SLURM_ARRAY_TASK_ID} in
{% for run in runs %}
  {{ run.run_id }})
    OUT_PATH="$OUT_DIRECTORY/run_{{ run.run_id }}.json"
    if [[ -f "$OUT_PATH" ]]; then
      echo "Run {{ run.run_id }} already complete, skipping."
      exit 0
    fi
    echo "=== Run {{ run.run_id }} (Block {{ run.block_id }}) ==="
{% for name, value in run.factor_values.items() %}    echo "  {{ name }} = {{ value }}"
{% endfor %}
{% if arg_style == "env" %}
{% for name, value in run.factor_values.items() %}    export {{ name | upper }}="{{ value }}"
{% endfor %}{% for name, value in fixed_factors.items() %}    export {{ name | upper }}="{{ value }}"
{% endfor %}    "{{ test_script }}" --out "$OUT_PATH"
{% elif arg_style == "positional" %}
    "{{ test_script }}" \
{% for name, value in run.factor_values.items() %}      "{{ value }}" \
{% endfor %}{% for name, value in fixed_factors.items() %}      "{{ value }}" \
{% endfor %}      --out "$OUT_PATH"
{% else %}
    "{{ test_script }}" \
{% for name, value in run.factor_values.items() %}      --{{ name }} "{{ value }}" \
{% endfor %}{% for name, value in fixed_factors.items() %}      --{{ name }} "{{ value }}" \
{% endfor %}      --out "$OUT_PATH"
{% endif %}
    ;;
{% endfor %}
  *)
    echo "Unknown SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID}" >&2
    exit 1
    ;;
esac
